# Copy to .env.local for local dev, and set the same in Vercel project settings.
GM_PASSWORD=change-me-gm
PLAYER_PASSWORD=change-me-player
# At least 32 random characters: openssl rand -base64 32
SESSION_SECRET=

# Vercel only: fine-grained GitHub token with read-only Contents access to the content repo.
CONTENT_REPO_TOKEN=
# Defaults to ray-cw/wiki-content
# CONTENT_REPO=ray-cw/wiki-content
